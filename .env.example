# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API). Never commit real values.

# Public: safe to expose to the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). Older projects can use the legacy anon key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public URL of the deployed site, used in invitation links and auth emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only, development seed script ONLY (scripts/seed-demo.mjs).
# The web app never reads this. Do not add it to Vercel.
SUPABASE_SECRET_KEY=
